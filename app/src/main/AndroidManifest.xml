<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.everymomentholy">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EveryMomentHoly"
        android:usesCleartextTraffic="true">

        <activity android:name=".ui.activity.SplashActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity android:name=".ui.activity.SelectOptionActivity" />

        <activity android:name=".ui.activity.RegisterActivity" />

        <activity android:name=".ui.activity.LoginActivity" />

        <activity android:name=".ui.activity.ForgotPasswordActivity" />

        <activity android:name=".ui.activity.ResetPasswordActivity"/>

        <activity android:name=".ui.activity.HomeActivity" />

        <activity android:name=".ui.activity.MainActivity" />

        <activity android:name=".ui.activity.GetCollectionActivity" />

        <activity android:name=".ui.activity.ChangePasswordActivity" />

        <activity android:name=".ui.activity.ContactUsActivty" />
    </application>

</manifest>