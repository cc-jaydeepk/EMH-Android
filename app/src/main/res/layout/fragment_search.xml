<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/progressCardView"
            android:layout_width="@dimen/progress_dialod_cardsize"
            android:layout_height="@dimen/progress_dialod_cardsize"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_7sdp"
            app:cardUseCompatPadding="true">

            <ProgressBar
                android:id="@+id/registerProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/loginbg"
                android:layout_marginBottom="@dimen/progressbar_margin_bottom" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/progress_margin_bottom"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:text="Loading"
                android:textColor="@color/black"
                android:textSize="@dimen/progress_loading_textsize" />

        </androidx.cardview.widget.CardView>


        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:fontFamily="@font/lato_medium"
            android:hint="SEARCH FOR....."
            android:imeOptions="actionDone"
            android:backgroundTint="@color/loginbg"
            android:textSize="@dimen/_12ssp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/ic_search"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:src="@drawable/ic_searchimg" />

        <LinearLayout
            android:id="@+id/linearResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/edtSearch"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/lato_bold"
                android:text="@string/result"
                android:textColor="@color/black"
                android:textSize="@dimen/search_result_textsize" />

            <TextView
                android:id="@+id/txt_search_item_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtResults"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginTop="@dimen/search_show_matches_text_margintop"
                android:fontFamily="@font/lato_light"
                android:textColor="@color/gray"
                android:textSize="@dimen/search_show_matches_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_below="@+id/txt_search_item_count"
                android:layout_marginTop="@dimen/search_view_margintop"
                android:layout_marginBottom="@dimen/search_view_marginbottom"
                android:background="@color/light_gray" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerviewSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/linearResult" />


    </RelativeLayout>


</LinearLayout>