<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/progressCardView"
        android:layout_width="@dimen/progress_dialod_cardsize"
        android:layout_height="@dimen/progress_dialod_cardsize"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_7sdp"
        app:cardUseCompatPadding="true">

        <ProgressBar
            android:id="@+id/registerProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/loginbg"
            android:layout_marginBottom="@dimen/progressbar_margin_bottom" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/progress_margin_bottom"
            android:fontFamily="@font/lato_medium"
            android:gravity="center"
            android:text="Loading"
            android:textColor="@color/black"
            android:textSize="@dimen/progress_loading_textsize" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_getLiturgies_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="invisible">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:orientation="vertical">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.04"
            android:gravity="center"
            android:orientation="vertical">

            <com.rd.PageIndicatorView
                android:id="@+id/pageIndicatorView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="@dimen/_5sdp"
                app:piv_animationType="scale"
                app:piv_dynamicCount="true"
                app:piv_interactiveAnimation="true"
                app:piv_selectedColor="@color/black"
                app:piv_unselectedColor="#8F8C8C"
                app:piv_viewPager="@id/viewPager" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/viewPager"
            android:layout_weight="0.14"
            android:gravity="center"
            android:orientation="vertical">

            <!-- android:layout_weight="0.19"-->

            <TextView
                android:id="@+id/txtLiturgyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="@dimen/getliturgy_txt_size" />

            <TextView
                android:id="@+id/txtDollar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/getliturgy_txtmargin"
                android:fontFamily="@font/lato_bold"
                android:text="$"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/getliturgy_purchstxt_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtLiturgyPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_4sdp"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:text="@string/purchased"
                android:textAllCaps="true"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/getliturgy_purchstxt_size"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp">

            <TextView
                android:id="@+id/txtSubscribeForFull"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:text="@string/subscribe_for_full_access_to_more_than_200_liturgies"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/_14ssp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/getliturgy_btnlayout"
            android:layout_marginRight="@dimen/getliturgy_btnlayout"
            android:layout_marginBottom="@dimen/_4sdp"
            android:layout_weight="0.19"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            android:visibility="visible">

            <TextView
                android:id="@+id/txtUnlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_unlock"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:padding="@dimen/getliturgy_btn_padding"
                android:text="Unlock"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/getliturgy_btn_txtsize" />

            <TextView
                android:id="@+id/txtGetLiturgiesAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_read_now"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:padding="@dimen/getliturgy_btn_padding"
                android:text="@string/about"
                android:textAllCaps="true"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/getliturgy_btn_txtsize"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
