<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_collection_raw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:src="@drawable/ic_collection" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <!--<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtLiturgyName"
                    style="@style/liturgiesListTitleTextStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minLines="2"
                    android:text="Liturgies Name" />


                <ImageView
                    android:id="@+id/imageBook"
                    android:layout_width="@dimen/getcollection_rightimg"
                    android:layout_height="@dimen/getcollection_rightimg"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:src="@drawable/ic_book" />
            </LinearLayout>-->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- <LinearLayout
                     android:layout_width="match_parent"
                     android:orientation="vertical"
                     android:layout_height="wrap_content">
                     <TextView
                         android:id="@+id/txtLiturgyName"
                         style="@style/liturgiesListTitleTextStyle"
                         android:layout_width="match_parent"
                         android:layout_weight="1"
                         android:minLines="2"
                         android:text="Liturgies Name" />

                     <TextView
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"/>

                 </LinearLayout>-->

                <TextView
                    android:id="@+id/txtLiturgyName"
                    style="@style/liturgiesListTitleTextStyle"
                    android:layout_width="match_parent"
                    android:layout_toLeftOf="@+id/imageBook"
                    android:layout_weight="1"
                    android:text="Liturgies Name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtLiturgyName"
                    android:layout_toLeftOf="@+id/imageBook"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtIncludedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_medium"
                        android:maxLines="1"
                        android:text="Included in: "
                        android:textColor="@color/graylight"
                        android:textSize="@dimen/includedtext" />

                    <TextView
                        android:id="@+id/txtIncludedIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txtLiturgyName"
                        android:layout_toLeftOf="@+id/imageBook"
                        android:fontFamily="@font/lato_medium"
                        android:maxLines="1"
                        android:text="Included in: "
                        android:textColor="@color/graylight"
                        android:textSize="@dimen/includedtext" />

                </LinearLayout>




                <ImageView
                    android:id="@+id/imageBook"
                    android:layout_width="@dimen/getcollection_rightimg"
                    android:layout_height="@dimen/getcollection_rightimg"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:src="@drawable/ic_book" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/priceLinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:fontFamily="@font/lato_medium"
                    android:text="@string/free"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/buttomsheet_freetxt_size"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/priceLinear"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center"
                android:orientation="horizontal">


                <!--<TextView
                    android:id="@+id/txtUnlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_unlock"
                    android:fontFamily="@font/lato_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="Unlock"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/getcollection_btntxt" />-->

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true">

                        <ImageView
                            android:id="@+id/imgShare"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/buttomsheet_shareimg_size"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center"
                            android:layout_weight="0.15"
                            android:gravity="center"
                            android:paddingLeft="3dp"
                            android:paddingRight="3dp"
                            android:visibility="gone"
                            android:src="@drawable/homeshare" />


                        <ImageView
                            android:id="@+id/imgFavorite"
                            android:layout_width="@dimen/buttomsheet_shareimg_size"
                            android:layout_height="@dimen/buttomsheet_shareimg_size"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center"
                            android:layout_marginRight="@dimen/_12sdp"
                            android:layout_toRightOf="@+id/imgShare"
                            android:gravity="center"
                            android:visibility="gone"
                            android:src="@drawable/ic_fevrite" />

                        <TextView

                            android:id="@+id/txtPlayNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_12sdp"
                            android:layout_toRightOf="@+id/imgFavorite"
                            android:background="@drawable/bg_unlock"
                            android:fontFamily="@font/lato_medium"
                            android:padding="@dimen/_6sdp"
                            android:text="Play Now"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="@dimen/getcollection_btntxt"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txtUnlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_15sdp"
                            android:layout_toRightOf="@+id/txtPlayNow"
                            android:background="@drawable/bg_unlock"
                            android:fontFamily="@font/lato_medium"
                            android:padding="@dimen/_6sdp"
                            android:text="Unlock"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="@dimen/getcollection_btntxt" />


                        <!-- <TextView
                             android:id="@+id/txtUnlock"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:layout_marginRight="@dimen/_12sdp"
                             android:layout_toRightOf="@+id/txtPlayNow"
                             android:background="@drawable/bg_unlock"
                             android:fontFamily="@font/lato_medium"
                             android:padding="@dimen/_8sdp"
                             android:text="Unlock"
                             android:textAllCaps="true"
                             android:textColor="@color/white"
                             android:textSize="@dimen/getcollection_btntxt" />-->

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/mainRelative"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:background="@android:color/black" />

</LinearLayout>