<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_layout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="25dp"
            android:layout_marginBottom="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/progressCardView"
                    android:layout_width="@dimen/progress_dialod_cardsize"
                    android:layout_height="@dimen/progress_dialod_cardsize"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_7sdp"
                    app:cardUseCompatPadding="true">

                    <ProgressBar
                        android:id="@+id/registerProgressBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/progressbar_margin_bottom"
                        android:indeterminateTint="@color/loginbg" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/progress_margin_bottom"
                        android:fontFamily="@font/lato_medium"
                        android:gravity="center"
                        android:text="Loading"
                        android:textColor="@color/black"
                        android:textSize="@dimen/progress_loading_textsize" />

                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/subscription_marginlr"
                    android:layout_marginTop="25dp"
                    android:layout_marginRight="@dimen/subscription_marginlr"
                    android:orientation="vertical">

                    <TextView
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold"
                        android:text="Current Plan" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Start Date" />

                    <TextView
                        android:id="@+id/txtStartDate"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Expiration Date" />

                    <TextView
                        android:id="@+id/txtExpiretDate"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Type"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/txtTypeDate"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Status"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/txtSttus"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold"
                        android:textColor="#4DBA51" />

                    <Button
                        android:id="@+id/btnUnsubscribe"
                        style="@style/edtStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10"
                        android:backgroundTint="@color/loginbg"
                        android:clickable="true"
                        android:text="UnSubscribe"
                        android:textColor="@color/white"
                        android:textSize="@dimen/login_button_txtsize" />

                    <TextView
                        style="@style/myStatusTextStyleRes"
                        android:layout_marginTop="25dp"
                        android:fontFamily="@font/lato_bold"
                        android:text="Upcomin Plan" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Start Date" />

                    <TextView
                        android:id="@+id/txtUpcominStartDate"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Expiration Date" />

                    <TextView
                        android:id="@+id/txtUpcominExpiretDate"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Type"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/txtUpcominTypeDate"
                        style="@style/myStatusTextStyleRes"
                        android:fontFamily="@font/lato_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black" />

                    <TextView
                        style="@style/myStatusTextStyle"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/lato_medium"
                        android:text="Status"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/txtUpcominSttus"
                        style="@style/myStatusTextStyleRes"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/lato_bold"
                        android:textColor="#4DBA51" />

                </LinearLayout>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>


    </ScrollView>

</LinearLayout>