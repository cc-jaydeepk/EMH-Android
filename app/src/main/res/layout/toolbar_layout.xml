<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize">

        <ImageView
            android:id="@+id/iv_toolbar_drawer"
            android:layout_width="@dimen/toolbar_drawer_imagesize"
            android:layout_height="@dimen/toolbar_drawer_imagesize"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_6sdp"
            android:src="@drawable/drawer_image" />

        <ImageView
            android:id="@+id/iv_toolbar_backImage"
            android:layout_width="@dimen/toolbar_drawer_imagesize"
            android:layout_height="@dimen/toolbar_drawer_imagesize"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_6sdp"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_toolbar_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/lato_medium"
            android:text="Every Moment Holy"
            android:textColor="@color/black"
            android:textSize="@dimen/toolbar_text_size" />

        <ImageView
            android:id="@+id/iv_toolbar_notification"
            android:layout_width="@dimen/toolbar_nitificationimage_size"
            android:layout_height="@dimen/toolbar_nitificationimage_size"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/_9sdp"
            android:src="@drawable/ic_notification"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_toolbar_search"
            android:layout_width="@dimen/toolbar_nitificationimage_size"
            android:layout_height="@dimen/toolbar_nitificationimage_size"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/_9sdp"
            android:src="@drawable/ic_searchimg"
            android:visibility="gone" />

        <!--<ImageView
            android:id="@+id/iv_toolbar_back"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_10sdp"
            android:src="@drawable/drawer_image" />

        <TextView
            android:id="@+id/txt_toolbar_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/app_name"
            android:textColor="@color/loginbg"
            android:textSize="@dimen/_18ssp" />

        <ImageView
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/_10sdp"
            android:src="@drawable/ic_search" />-->

    </RelativeLayout>

</LinearLayout>