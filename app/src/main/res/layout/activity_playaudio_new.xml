<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F3F0F0">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:src="@drawable/ic_close_icon" />
        

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/ivClose"
            android:layout_centerInParent="true"
            android:layout_marginTop="25dp"
            android:gravity="center">


            <ImageView
                android:id="@+id/ivLiturgyImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_music_icon" />

            <LinearLayout
                android:id="@+id/layoutLinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ivLiturgyImage"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtLiturgyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ivLiturgyImage"
                    android:layout_marginLeft="@dimen/_7sdp"
                    android:layout_marginRight="@dimen/_7sdp"
                    android:fontFamily="@font/lato_bold"
                    android:gravity="center"
                    android:text="liturgy Name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/playaudio_titletxt_size" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/relativeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layoutLinear"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="10dp">

                <SeekBar
                    android:id="@+id/seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:progressDrawable="@drawable/seek_bar"
                    android:progressTint="@color/loginbg"
                    android:thumb="@drawable/seek_thumb"
                    android:thumbTint="@color/white" />

                <TextView
                    android:id="@+id/txtCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/seekbar"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/lato_regular"
                    android:text="00:00:00"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/playaudio_txt_size" />

                <TextView
                    android:id="@+id/txtTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/seekbar"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="10dp"
                    android:fontFamily="@font/lato_regular"
                    android:text="00:00:00"
                    android:textColor="@color/black"
                    android:textSize="@dimen/playaudio_txt_size" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/ivPause"
                android:layout_width="@dimen/playaudio_playbtn"
                android:layout_height="@dimen/playaudio_playbtn"
                android:layout_below="@+id/relativeSeek"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_pausess" />

            <ImageView
                android:id="@+id/ivPlay"
                android:layout_width="@dimen/playaudio_playbtn"
                android:layout_height="@dimen/playaudio_playbtn"
                android:layout_below="@+id/ivPause"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_play"
                android:visibility="gone" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ivPlay"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivVolumeDown"
                    android:layout_width="@dimen/playaudio_volume_increse"
                    android:layout_height="@dimen/playaudio_volume_increse"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="7dp"
                    android:src="@drawable/ic_volume_down" />

                <SeekBar
                    android:id="@+id/volumeSeekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/ivVolumeUp"
                    android:layout_toEndOf="@+id/ivVolumeDown"
                    android:progressDrawable="@drawable/seek_bar"
                    android:progressTint="@color/loginbg"
                    android:thumb="@drawable/seek_thumb"
                    android:thumbTint="@color/white" />

                <ImageView
                    android:id="@+id/ivVolumeUp"
                    android:layout_width="@dimen/playaudio_volume_increse"
                    android:layout_height="@dimen/playaudio_volume_increse"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="7dp"
                    android:src="@drawable/ic_volume_up" />

            </RelativeLayout>

        </RelativeLayout>


    </RelativeLayout>

</RelativeLayout>