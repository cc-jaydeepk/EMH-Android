<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/progressCardView"
            android:layout_width="@dimen/progress_dialod_cardsize"
            android:layout_height="@dimen/progress_dialod_cardsize"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_7sdp"
            app:cardUseCompatPadding="true">

            <ProgressBar
                android:id="@+id/registerProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/progressbar_margin_bottom" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/progress_margin_bottom"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:text="Loading"
                android:textColor="@color/black"
                android:textSize="@dimen/progress_loading_textsize" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/toolbarBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                android:id="@+id/ivRegiBack"
                android:layout_width="@dimen/back_icon_size"
                android:layout_height="@dimen/back_icon_size"
                android:layout_margin="@dimen/back_icon_margin"
                android:padding="@dimen/back_icon_padding"
                android:src="@drawable/ic_back" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbarBack">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- <ImageView
                     android:id="@+id/ivLoginBack"
                     android:layout_width="@dimen/_40sdp"
                     android:layout_height="@dimen/_40sdp"
                     android:layout_margin="@dimen/_10sdp"
                     android:padding="@dimen/_10sdp"
                     android:src="@drawable/ic_back" />-->

                <ImageView
                    android:layout_width="@dimen/register_imgsize"
                    android:layout_height="@dimen/register_imgsize"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:src="@drawable/login_topimg" />

                <TextView
                    style="@style/bigTextStyle"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/margintop_to_image"
                    android:text="@string/login_to_continue" />

                <!--<TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rgstr_img_margin"
                    android:text="@string/login_to_continue"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/rgstr_txtsize" />-->

                <EditText
                    android:id="@+id/edtLoginEmail"
                    style="@style/edtStyle"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/rgste_fstnm_margintop"
                    android:background="@drawable/bg_register_edt"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/edtLoginPassword"
                    style="@style/edtStyle"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/editText_margintop"
                    android:background="@drawable/bg_register_edt"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/txtForgotPsw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:layout_marginRight="@dimen/_15sdp"
                    android:fontFamily="@font/lato_regular"
                    android:gravity="right"
                    android:text="@string/forgot_password"
                    android:textColor="@color/black"
                    android:textSize="@dimen/forgot_textsize" />

                <!--<Button
                    android:id="@+id/btn_Login"
                    style="@style/edtStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_margin"
                    android:backgroundTint="@color/loginbg"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_button_txtsize" />-->

                <Button
                    android:id="@+id/btn_Login"
                    style="@style/registerButtonStyle"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/_30sdp"
                    android:text="@string/login" />


            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</RelativeLayout>