<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="@dimen/_240sdp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:minHeight="@dimen/_280sdp"
            app:cardBackgroundColor="#FEFAFA"
            app:cardElevation="6dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quoteTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:fontFamily="@font/lato_regular"
                    android:gravity="center"
                    android:textSize="@dimen/_12ssp" />


                <TextView
                    android:id="@+id/parentLiturgyTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:fontFamily="@font/lato_regular"
                    android:gravity="center"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/_11ssp" />


                <TextView
                    android:id="@+id/dateTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_regular"
                    android:gravity="center"
                    android:text="dhsfhgfdjdvhldfkjgf;lv"
                    android:textColor="#000"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="gone" />


            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <LinearLayout
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/red_notification_circle"
            android:elevation="@dimen/_15sdp"
            android:gravity="center"
            android:visibility="visible">

            <ImageView
                android:id="@+id/shareImage"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_share"
                android:visibility="visible"
                app:tint="@color/white" />

        </LinearLayout>

    </RelativeLayout>


</RelativeLayout>