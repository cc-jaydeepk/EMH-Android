<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/orderbook_layoutmargin"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_orderbook"
            android:layout_width="@dimen/orderbook_imagesixe"
            android:layout_height="@dimen/orderbook_imagesixe"
            android:layout_centerVertical="true"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/orderbook_marginright"
            android:layout_toRightOf="@+id/iv_orderbook"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_order_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_semibold"
                android:text="Every Moment Holy, Vol 1 - Pocket Edition "
                android:textColor="@color/black"
                android:textSize="@dimen/orderbook_txtname" />

            <LinearLayout
                android:id="@+id/btn_order_book_rabbit_room"
                android:layout_width="@dimen/_110sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_read_now"
                android:orientation="horizontal"
                android:padding="@dimen/_2sdp">

                <LinearLayout
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:background="@color/loginbg"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp"
                        android:src="@drawable/ic_rabbit_room" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/lato_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/rabbit_room"
                    android:textAllCaps="true"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/orderbook_btn_txtsixe" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_order_book_amazon"
                android:layout_width="@dimen/_110sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_read_now"
                android:orientation="horizontal"
                android:padding="@dimen/_2sdp">

                <LinearLayout
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:background="@color/loginbg"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_amazone_icon" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/lato_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/amazon"
                    android:textAllCaps="true"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/orderbook_btn_txtsixe" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:background="#C3C0C0" />

</LinearLayout>