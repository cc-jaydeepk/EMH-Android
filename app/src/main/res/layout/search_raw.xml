<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgFeatured"
            style="@style/liturgiesListImageStyle"
            app:srcCompat="@drawable/ic_fav_liturgy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- <TextView
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:text="A Liturgies for"
                 android:textColor="@color/black"
                 android:textSize="@dimen/_18ssp" />-->

            <TextView
                style="@style/liturgiesListTitleTextStyle"
                android:text="A Liturgies for" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_medium"
                android:text="Domestic Days"
                android:textColor="@color/black"
                android:textSize="@dimen/fav_frag_freetxt" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_17sdp"
                    android:fontFamily="@font/lato_medium"
                    android:text="@string/free"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/fav_frag_freetxt" />

                <!--<Button
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="@dimen/openbtnn_width"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:fontFamily="@font/lato_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="Read Now"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/fav_frag_btn"
                    app:strokeColor="@color/loginbg" />-->

                <Button
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="@dimen/openbtnn_width"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:layout_marginRight="@dimen/_9sdp"
                    android:fontFamily="@font/lato_medium"
                    android:padding="@dimen/_3sdp"
                    android:text="Read Now"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/openbtnn_textsize"
                    app:strokeColor="@color/loginbg" />

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/imgFavCover"
        android:layout_marginTop="@dimen/viewmargin"
        android:background="@android:color/black" />

</LinearLayout>