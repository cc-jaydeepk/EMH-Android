<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_dialog"
        android:gravity="center"
        android:orientation="vertical">


        <TextView
            style="@style/dialogBigTextStyle"
            android:layout_marginLeft="@dimen/_7sdp"
            android:layout_marginRight="@dimen/_7sdp"
            android:gravity="center"
            android:text="@string/app_name" />

        <TextView
            style="@style/dialogSmallTextStyle"
            android:layout_marginLeft="@dimen/_7sdp"
            android:layout_marginRight="@dimen/_7sdp"
            android:gravity="center"
            android:text="You need to Login first" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="#DAD5D5" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:orientation="horizontal">

            <!-- <TextView
                 android:id="@+id/txtOk"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/_3sdp"
                 android:layout_weight="1"
                 android:gravity="center"
                 android:text="Ok"
                 android:textColor="#51A8ED"
                 android:textSize="@dimen/_16ssp"
                 android:textStyle="bold" />-->

            <TextView
                android:id="@+id/txtLoginOk"
                style="@style/dialogOkTextStyle"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ok" />

            <View
                android:layout_width="1dp"
                android:layout_height="@dimen/_33sdp"
                android:layout_toRightOf="@id/txtOk"
                android:background="#DAD5D5" />

            <!--<TextView
                android:id="@+id/txtCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="#F44336"
                android:textSize="@dimen/_16ssp" />-->

            <TextView
                android:id="@+id/txtLoginCancel"
                style="@style/dialogCancelTextStyle"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cancel" />


        </LinearLayout>

    </LinearLayout>

</LinearLayout>