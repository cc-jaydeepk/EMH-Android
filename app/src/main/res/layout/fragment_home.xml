        <RelativeLayout
            android:id="@+id/toolbar_relativ"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="?actionBarSize">

            <ImageView
                android:id="@+id/iv_toolbar_drawer"
                android:layout_width="@dimen/toolbar_drawer_imagesize"
                android:layout_height="@dimen/toolbar_drawer_imagesize"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_15sdp"
                android:src="@drawable/drawer_image" />


            <TextView
                android:id="@+id/txt_toolbar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/lato_mediumitalic"
                android:text="Every Moment Holy"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/toolbar_text_size" />

            <ImageView
                android:id="@+id/iv_toolbar_notification"
                android:layout_width="@dimen/toolbar_nitificationimage_size"
                android:layout_height="@dimen/toolbar_nitificationimage_size"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_9sdp"
                android:src="@drawable/ic_notification"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txt_toolbar_notification_count"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_alignParentRight="true"
                android:layout_margin="@dimen/_2sdp"
                android:background="@drawable/red_notification_circle"
                android:gravity="center"
                android:text="50"
                android:textColor="@color/white"
                android:visibility="gone" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbar_relativ">

            <!--android:layout_below="@+id/toolbar_relativ"-->

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/lato_medium"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_18ssp"
                        android:visibility="gone" />

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:gravity="center"
                        android:orientation="vertical">


                        <ImageView
                            android:id="@+id/imgHomeClock"
                            android:layout_width="@dimen/home_img"
                            android:layout_height="@dimen/home_img" />

                        <TextView
                            android:id="@+id/txtDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/liturgitxtmargin"
                            android:fontFamily="@font/lato_medium"
                            android:text=""
                            android:textColor="@color/loginbg"
                            android:textSize="@dimen/liturgitxtsize" />

                        <TextView
                            android:id="@+id/txtTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_7ssp"
                            android:fontFamily="@font/lato_medium"
                            android:text="@string/daily_liturgy_quote"
                            android:textColor="@color/loginbg"
                            android:textSize="@dimen/home_frg_liturgiesnm"
                            android:textStyle="bold" />

