<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/progressCardView"
        android:layout_width="@dimen/progress_dialod_cardsize"
        android:layout_height="@dimen/progress_dialod_cardsize"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_7sdp"
        app:cardUseCompatPadding="true">

        <ProgressBar
            android:id="@+id/registerProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/loginbg"
            android:layout_marginBottom="@dimen/progressbar_margin_bottom" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/progress_margin_bottom"
            android:fontFamily="@font/lato_medium"
            android:gravity="center"
            android:text="Loading"
            android:textColor="@color/black"
            android:textSize="@dimen/progress_loading_textsize" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/linearMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:visibility="visible">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/toolbar_back"
                android:layout_height="@dimen/toolbar_back"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:src="@drawable/ic_back"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_toolbar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/lato_medium"
                android:text="Subscription Plans"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="@dimen/toolbar_text_size"
                android:visibility="gone" />




        </RelativeLayout>
       <!-- android:layout_marginTop="@dimen/skip_margin"-->
        <TextView
            android:id="@+id/txtSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="15dp"
            android:layout_gravity="right"
            android:background="@drawable/txt_buttom_border"
            android:fontFamily="@font/lato_bold"
            android:gravity="center"
            android:padding="4dp"
            android:text="Skip"
            android:textAllCaps="true"
            android:textColor="@color/loginbg"
            android:textSize="@dimen/skip_txtsize" />


        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">



            <!--<TextView
                android:id="@+id/txtSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="@dimen/skip_margin"
                android:background="@drawable/txt_buttom_border"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:layout_marginRight="15dp"
                android:text="Skip"
                android:textAllCaps="true"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/skip_txtsize" />-->

            <TextView
                android:id="@+id/TextStatic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/marginleft"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/marginleft"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:text="Subscribe for Unlimited Access"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/subscribe_titletxt" />

            <TextView
                android:id="@+id/txtSubscribe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/TextStatic"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:text="@string/subscribetext"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/_12ssp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvSubscriptionPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtSubscribe"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="10dp">

            </androidx.recyclerview.widget.RecyclerView>

            <!--<TextView
                android:id="@+id/txtFreeTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcvSubscriptionPlan"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:text="*Free LifeTime"
                android:textAllCaps="true"
                android:textColor="@color/loginbg"
                android:textSize="24sp"
                android:visibility="gone" />-->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcvSubscriptionPlan"
                android:layout_marginLeft="35dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="35dp"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:text="Limited access to the selected content"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/subscribe_titletxt"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSubscribeNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/subscribe_nowbtnmarginbtm"
                android:paddingLeft="28dp"
                android:paddingTop="12dp"
                android:paddingRight="28dp"
                android:paddingBottom="12dp"
                android:text="Subscribe Now"
                android:textSize="@dimen/subscribe_nowbtn" />

            <!--<LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_below="@+id/rcvSubscriptionPlan"
                android:layout_gravity="center"
                android:layout_marginTop="50dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnSubscribeNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="28dp"
                    android:paddingTop="15dp"
                    android:paddingRight="28dp"
                    android:paddingBottom="15dp"
                    android:text="Subscribe Now"
                    android:textSize="16sp" />

            </LinearLayout>-->

        </RelativeLayout>

    </LinearLayout>


</RelativeLayout>