<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/mainRelative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp">

        <ImageView
            android:id="@+id/imgLiturgycoverImage"
            style="@style/liturgiesListImageStyle"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_fav_liturgy" />


        <TextView
            android:id="@+id/txtLiturgiesTitle"
            style="@style/liturgiesListTitleTextStyle"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/_85sdp"
            android:layout_marginLeft="@dimen/_85sdp"
            android:layout_marginTop="@dimen/_3sdp" />


        <Button
            android:id="@+id/btnOpen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/_85sdp"
            android:layout_marginLeft="@dimen/_85sdp"
            android:layout_marginTop="66dp"
            android:fontFamily="@font/lato_medium"
            android:text="@string/open"
            android:textColor="@color/loginbg"
            android:textSize="@dimen/_10ssp"
            app:strokeColor="@color/loginbg" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/mainRelative"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:background="@android:color/black" />


</RelativeLayout>