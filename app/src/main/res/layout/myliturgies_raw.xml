<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/mainRelative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/myliturgy_mainlayout_margin">

        <ImageView
            android:id="@+id/imgLiturgycoverImage"
            style="@style/liturgiesListImageStyle"
            android:src="@drawable/ic_fav_liturgy" />

        <TextView
            android:id="@+id/txtLiturgiesTitle"
            style="@style/liturgiesListTitleTextStyle"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/openbtnn_marginleft"
            android:layout_marginLeft="@dimen/openbtnn_marginleft"
            android:layout_marginTop="@dimen/_2sdp" />




        <TextView
            android:id="@+id/txtLiturgiesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtLiturgiesTitle"
            android:layout_marginStart="@dimen/openbtnn_marginleft"
            android:layout_marginLeft="@dimen/openbtnn_marginleft"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/lato_semibold"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp" />

        <Button
            android:id="@+id/btnOpen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="@dimen/openbtnn_width"
            android:layout_height="@dimen/openbtnn_height"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/openbtnn_marginleft"
            android:layout_marginLeft="@dimen/openbtnn_marginleft"
            android:layout_marginTop="@dimen/openbtnn_margintop"
            android:fontFamily="@font/lato_medium"
            android:text="@string/open"
            android:textColor="@color/loginbg"
            android:textSize="@dimen/openbtnn_textsize"
            app:strokeColor="@color/loginbg" />


    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/mainRelative"
        android:layout_marginLeft="@dimen/myliturgy_view_margin_left"
        android:layout_marginRight="@dimen/myliturgy_view_margin_left"
        android:background="@android:color/black" />

</RelativeLayout>