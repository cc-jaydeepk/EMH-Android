<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.SubscriptionPlanListActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/progressCardView"
            android:layout_width="@dimen/progress_dialod_cardsize"
            android:layout_height="@dimen/progress_dialod_cardsize"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_7sdp"
            app:cardUseCompatPadding="true">

            <ProgressBar
                android:id="@+id/registerProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/progressbar_margin_bottom" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/progress_margin_bottom"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:text="Loading"
                android:textColor="@color/black"
                android:textSize="@dimen/progress_loading_textsize" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textSubscribePlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:allowUndo="true"
            android:fontFamily="@font/lato_semibold"
            android:gravity="center"
            android:text="subscription plans"
            android:textAllCaps="true"
            android:textColor="@color/loginbg"
            android:textSize="@dimen/_18ssp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvSubscriptionPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textSubscribePlan"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="10dp">

        </androidx.recyclerview.widget.RecyclerView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rcvSubscriptionPlan"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnSubscribeNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="28dp"
                android:paddingTop="15dp"
                android:paddingRight="28dp"
                android:paddingBottom="15dp"
                android:text="Subscribe Now"
                android:textSize="16sp" />

        </LinearLayout>

    </RelativeLayout>


</RelativeLayout>