<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/progressbar_home_fragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/loginbg" />

    <RelativeLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/toolbar_relativ"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize">

            <ImageView
                android:id="@+id/iv_toolbar_drawer"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_15sdp"
                android:src="@drawable/drawer_image" />


            <TextView
                android:id="@+id/txt_toolbar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Every Moment Holy"
                android:textColor="#000"
                android:textSize="@dimen/_18ssp" />

            <ImageView
                android:id="@+id/iv_toolbar_notification"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_9sdp"
                android:src="@drawable/ic_notification"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txt_toolbar_notification_count"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_alignParentRight="true"
                android:layout_margin="@dimen/_2sdp"
                android:gravity="center"
                android:text="50"
                android:textColor="@color/white"
                android:visibility="gone" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/mainrelative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar_relativ"
            android:layout_marginTop="@dimen/_30sdp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/_18ssp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgHomeClock"
                android:layout_width="@dimen/home_img"
                android:layout_height="@dimen/home_img"
                android:layout_centerHorizontal="true" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:text="20 June 2022"
                android:textColor="@color/loginbg"
                android:textSize="@dimen/liturgitxtsize" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_semibold"
                android:gravity="center"
                android:text="Daily Liturgy Quote"
                android:textColor="@color/black"
                android:textSize="@dimen/home_frg_liturgiesnm" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/mainrelative"
            android:layout_marginTop="@dimen/_35sdp">

            <ImageView
                android:id="@+id/leftArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_margin="3dp"
                android:src="@drawable/left_arrow" />

            <com.yuyakaido.android.cardstackview.CardStackView
                android:id="@+id/card_stack"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_toLeftOf="@+id/rightArraw"
                android:layout_toRightOf="@+id/leftArrow"
                android:clipToPadding="false"
                android:padding="4dp">

            </com.yuyakaido.android.cardstackview.CardStackView>


            <ImageView
                android:id="@+id/rightArraw"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_margin="3dp"
                android:src="@drawable/right_arrow" />


        </RelativeLayout>

        <ImageView
            android:id="@+id/shareImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_below="@id/relative"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="-53dp"
            android:elevation="15dp"
            android:src="@drawable/ic_share" />

        <TextView
            android:id="@+id/txtQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/home_frg_txtmrg"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/home_frg_txtmrg"
            android:fontFamily="@font/lato_mediumitalic"
            android:gravity="center"
            android:textColor="@color/loginbg"
            android:textSize="@dimen/home_frg_size"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivHomeShare"
            android:layout_width="@dimen/home_frg_shareimg"
            android:layout_height="@dimen/home_frg_shareimg"
            android:layout_marginTop="@dimen/home_share_icon"
            android:src="@drawable/homeshare"
            android:visibility="gone"
            app:tint="@color/loginbg" />

    </RelativeLayout>

</RelativeLayout>