<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/progressCardView"
        android:layout_width="@dimen/progress_dialod_cardsize"
        android:layout_height="@dimen/progress_dialod_cardsize"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_7sdp"
        app:cardUseCompatPadding="true">

        <ProgressBar
            android:id="@+id/registerProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/progressbar_margin_bottom" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/progress_margin_bottom"
            android:fontFamily="@font/lato_medium"
            android:gravity="center"
            android:text="Loading"
            android:textColor="@color/black"
            android:textSize="@dimen/progress_loading_textsize" />

    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_image_hight"
                    android:background="@drawable/ic_profilebg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!--<de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile_image"
                        android:layout_width="@dimen/myprofile_img"
                        android:layout_height="@dimen/myprofile_img"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:src="@drawable/profileimage" />-->

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile_image"
                        android:layout_width="@dimen/myprofile_img"
                        android:layout_height="@dimen/myprofile_img"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:src="@drawable/profileimage" />

                    <ImageView
                        android:id="@+id/ivOpenGallery"
                        android:layout_width="@dimen/profile_edit_icon"
                        android:layout_height="@dimen/profile_edit_icon"
                        android:layout_marginStart="@dimen/profile_edit_iconmargin"
                        android:layout_marginLeft="@dimen/profile_edit_iconmargin"
                        android:layout_marginTop="-49dp"
                        android:src="@drawable/ic_edit_image"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtUseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/lato_medium"
                        android:gravity="center"
                        android:text="Full name"
                        android:textColor="@color/white"
                        android:textSize="@dimen/myprofile_txtname_size" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_historybtn_layout"
                        android:layout_marginLeft="@dimen/profile_historybtn_margin"
                        android:layout_marginRight="@dimen/profile_historybtn_margin"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <ImageView
                            android:id="@+id/ivOrderHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/profile_historybtn"
                            android:layout_weight="1"
                            android:src="@drawable/ic_orderhistory" />

                        <ImageView
                            android:id="@+id/ivChangePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/profile_historybtn"
                            android:layout_weight="1"
                            android:src="@drawable/change_password" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textFree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/free"
                        android:textSize="@dimen/_18ssp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/edtUserFirstName"
                        style="@style/edtStyle"
                        android:layout_marginTop="@dimen/rgste_margintop"
                        android:background="@drawable/bg_register_edt"
                        android:enabled="false"
                        android:hint="First name"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/edtUserLastName"
                        style="@style/edtStyle"
                        android:layout_marginTop="@dimen/editText_margintop"
                        android:background="@drawable/bg_register_edt"
                        android:enabled="false"
                        android:hint="Last name"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/edtUserEmail"
                        style="@style/edtStyle"
                        android:layout_marginTop="@dimen/editText_margintop"
                        android:background="@drawable/bg_register_edt"
                        android:enabled="false"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:singleLine="true" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/rgste_fstnm_marginleft"
                        android:layout_marginTop="@dimen/editText_margintop"
                        android:layout_marginRight="@dimen/rgste_fstnm_marginleft"
                        android:background="@drawable/bg_register_edt">

                        <com.hbb20.CountryCodePicker
                            android:id="@+id/country_code_picker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            app:showFlag="false" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/view_hight"
                            android:layout_toRightOf="@id/country_code_picker"
                            android:background="@color/black" />

                        <EditText
                            android:id="@+id/edtUserPhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_2sdp"
                            android:layout_toRightOf="@+id/country_code_picker"
                            android:background="@null"
                            android:enabled="false"
                            android:fontFamily="@font/lato_medium"
                            android:gravity="center_vertical"
                            android:hint="@string/phone_number"
                            android:inputType="phone"
                            android:padding="@dimen/login_button_padding"
                            android:singleLine="true"
                            android:textSize="@dimen/edittext_hint_size" />

                        <TextView
                            android:id="@+id/shadowView"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_centerInParent="true"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/btnEditProfile"
                            style="@style/edtStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:backgroundTint="@color/loginbg"
                            android:clickable="true"
                            android:text="@string/edit_profile"
                            android:textColor="@color/white"
                            android:textSize="@dimen/login_button_txtsize" />

                        <Button
                            android:id="@+id/btnUpdateProfile"
                            style="@style/edtStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10"
                            android:backgroundTint="@color/loginbg"
                            android:text="Update Profile"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="@dimen/login_button_txtsize"
                            android:visibility="gone" />

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>