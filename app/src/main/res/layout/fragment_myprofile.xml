<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/progressCardView"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_130sdp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_7sdp"
        app:cardUseCompatPadding="true">

        <ProgressBar
            android:id="@+id/registerProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/_15sdp"
            android:gravity="center"
            android:text="Loading"
            android:textColor="@color/black"
            android:textSize="@dimen/_15ssp" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_210sdp"
            android:background="@drawable/ic_profilebg"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!--<de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="@dimen/myprofile_img"
                android:layout_height="@dimen/myprofile_img"
                android:layout_marginTop="@dimen/_10sdp"
                android:src="@drawable/profileimage" />-->

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="@dimen/myprofile_img"
                android:layout_height="@dimen/myprofile_img"
                android:layout_marginTop="@dimen/_20sdp"
                android:src="@drawable/profileimage" />

            <ImageView
                android:id="@+id/ivOpenGallery"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginStart="@dimen/_38sdp"
                android:layout_marginLeft="@dimen/_38sdp"
                android:layout_marginTop="-49dp"
                android:src="@drawable/ic_edit_image"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtUseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/lato_medium"
                android:gravity="center"
                android:text="Denisha Varagiya"
                android:textColor="@color/white"
                android:textSize="@dimen/myprofile_txtname_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:gravity="center"
                android:orientation="horizontal">


                <ImageView
                    android:id="@+id/ivOrderHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_orderhistory" />

                <ImageView
                    android:id="@+id/ivChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:src="@drawable/change_password" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/free"
                android:textSize="@dimen/_18ssp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/edtUserFirstName"
                style="@style/edtStyle"
                android:layout_marginTop="@dimen/rgste_margintop"
                android:background="@drawable/bg_register_edt"
                android:enabled="false"
                android:hint="Denisha"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/edtUserLastName"
                style="@style/edtStyle"
                android:layout_marginTop="@dimen/rgste_margintop"
                android:background="@drawable/bg_register_edt"
                android:enabled="false"
                android:hint="Varagiya"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/edtUserEmail"
                style="@style/edtStyle"
                android:layout_marginTop="@dimen/rgste_margintop"
                android:background="@drawable/bg_register_edt"
                android:enabled="false"
                android:hint="varagiyadm@gmail.com"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/rgste_fstnm_marginleft"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginRight="@dimen/rgste_fstnm_marginleft"
                android:background="@drawable/bg_register_edt">

                <com.hbb20.CountryCodePicker
                    android:id="@+id/country_code_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:focusable="false"
                    app:showFlag="false">

                </com.hbb20.CountryCodePicker>

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/view_hight"
                    android:layout_toRightOf="@id/country_code_picker"
                    android:background="@color/black" />

                <EditText
                    android:id="@+id/edtUserPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_2sdp"
                    android:layout_toRightOf="@+id/country_code_picker"
                    android:background="@null"
                    android:enabled="false"
                    android:fontFamily="@font/lato_medium"
                    android:gravity="center_vertical"
                    android:hint="@string/phone_number"
                    android:inputType="phone"
                    android:padding="@dimen/login_button_padding"
                    android:singleLine="true"
                    android:textSize="@dimen/_12ssp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnEditProfile"
                    style="@style/edtStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10"
                    android:backgroundTint="@color/loginbg"
                    android:clickable="true"
                    android:text="@string/edit_profile"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_button_txtsize" />

                <Button
                    android:id="@+id/btnUpdateProfile"
                    style="@style/edtStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10"
                    android:backgroundTint="@color/loginbg"
                    android:text="Update Profile"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_button_txtsize"
                    android:visibility="gone" />

            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>


</RelativeLayout>