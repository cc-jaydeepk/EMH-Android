<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_210sdp"
        android:background="@drawable/ic_profilebg"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="@dimen/myprofile_img"
            android:layout_height="@dimen/myprofile_img"
            android:layout_marginTop="@dimen/_10sdp"
            android:src="@drawable/profileimage" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center"
            android:text="Denisha Varagiya"
            android:textColor="@color/white"
            android:textSize="@dimen/myprofile_txtname_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_70sdp"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:gravity="center"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/imgOrderHis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:layout_weight="1"
                android:src="@drawable/ic_orderhistory" />

            <ImageView
                android:id="@+id/imgChangePsw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:layout_weight="1"
                android:src="@drawable/change_password" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            style="@style/edtStyle"
            android:layout_marginTop="@dimen/rgste_margintop"
            android:background="@drawable/bg_register_edt"
            android:hint="Denisha" />

        <EditText
            style="@style/edtStyle"
            android:layout_marginTop="@dimen/rgste_margintop"
            android:background="@drawable/bg_register_edt"
            android:hint="Varagiya" />

        <EditText
            style="@style/edtStyle"
            android:layout_marginTop="@dimen/rgste_margintop"
            android:background="@drawable/bg_register_edt"
            android:hint="varagiyadm@gmail.com" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/rgste_fstnm_marginleft"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_marginRight="@dimen/rgste_fstnm_marginleft"
            android:background="@drawable/bg_register_edt">

            <com.hbb20.CountryCodePicker
                android:id="@+id/country_code_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:showFlag="false">

            </com.hbb20.CountryCodePicker>

            <View
                android:layout_width="1dp"
                android:layout_height="@dimen/view_hight"
                android:layout_toRightOf="@id/country_code_picker"
                android:background="@color/black" />

            <EditText
                android:id="@+id/edtPhoneNuber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_2sdp"
                android:layout_toRightOf="@+id/country_code_picker"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/phone_number"
                android:padding="@dimen/login_button_padding" />

        </RelativeLayout>

        <Button
            style="@style/edtStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10"
            android:backgroundTint="@color/loginbg"
            android:text="@string/edit_profile"
            android:textColor="@color/white"
            android:textSize="@dimen/login_button_txtsize" />

    </LinearLayout>

</LinearLayout>