<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:src="@drawable/ic_collection" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <TextView
                    android:id="@+id/txtLiturgyName"
                    style="@style/liturgiesListTitleTextStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Liturgies Name" />

                <ImageView
                    android:id="@+id/imageBook"
                    android:layout_width="@dimen/getcollection_rightimg"
                    android:layout_height="@dimen/getcollection_rightimg"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:src="@drawable/ic_book" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtLiturgiesTitle"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:fontFamily="@font/lato_medium"
                    android:text="@string/free"
                    android:textColor="@color/loginbg"
                    android:textSize="@dimen/buttomsheet_freetxt_size" />

                <Button
                    android:id="@+id/btnUnlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtLiturgyName"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:backgroundTint="@color/loginbg"
                    android:padding="@dimen/_5sdp"
                    android:text="Unlock"
                    android:textSize="@dimen/getcollection_btntxt" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/coverImage"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@android:color/black" />

    </LinearLayout>

</LinearLayout>