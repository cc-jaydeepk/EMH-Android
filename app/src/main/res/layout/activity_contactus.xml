<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize">

            <ImageView
                android:id="@+id/iv_toolbar_backImage"
                android:layout_width="@dimen/toolbar_drawer_imagesize"
                android:layout_height="@dimen/toolbar_drawer_imagesize"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_6sdp"
                android:src="@drawable/ic_back"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txt_toolbar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/lato_medium"
                android:text="Contact Us"
                android:textColor="@color/black"
                android:textSize="@dimen/toolbar_text_size" />

        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbar"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/register_imgsize"
                android:layout_height="@dimen/register_imgsize"
                android:src="@drawable/login_topimg" />

            <EditText
                android:id="@+id/edtYourName"
                style="@style/edtStyle"
                android:layout_marginTop="@dimen/rgste_margintop"
                android:background="@drawable/bg_register_edt"
                android:hint="@string/your_name" />

            <EditText
                android:id="@+id/edtEmailAddress"
                style="@style/edtStyle"
                android:layout_marginTop="@dimen/rgste_fstnm_margintop"
                android:background="@drawable/bg_register_edt"
                android:hint="Your E-Mail Address" />

            <EditText
                android:id="@+id/edtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:background="@drawable/bg_register_edt"
                android:lines="3"
                android:maxLines="7"
                android:padding="@dimen/_25sdp" />

            <Button
                android:id="@+id/btnContactusSubmit"
                style="@style/edtStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:backgroundTint="@color/loginbg"
                android:text="@string/submit"
                android:textColor="@color/white"
                android:textSize="@dimen/login_button_txtsize" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>