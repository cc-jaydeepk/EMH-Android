<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_layout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivClock"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_200sdp"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_30sdp"
                android:src="@drawable/login_topimg" />

            <EditText
                android:id="@+id/edtOldPassword"
                style="@style/edtStyle"
                android:layout_below="@+id/ivClock"
                android:layout_marginTop="@dimen/_25sdp"
                android:background="@drawable/bg_register_edt"
                android:hint="@string/old_password" />

            <EditText
                android:id="@+id/edtNewpPassword"
                style="@style/edtStyle"
                android:layout_below="@+id/edtOldPassword"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/bg_register_edt"
                android:hint="@string/new_password" />

            <EditText
                android:id="@+id/edtConformPsw"
                style="@style/edtStyle"
                android:layout_below="@+id/edtNewpPassword"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/bg_register_edt"
                android:hint="@string/confirm_password" />

            <Button
                android:id="@+id/btnSubmitPassword"
                style="@style/edtStyle"
                android:layout_below="@+id/edtConformPsw"
                android:layout_marginTop="@dimen/_30sdp"
                android:backgroundTint="@color/loginbg"
                android:text="@string/submit" />

        </RelativeLayout>

    </ScrollView>


</LinearLayout>