<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EveryMomentHoly" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/loginbg</item>
        <item name="colorPrimaryVariant">@color/loginbg</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!--<style name="edtStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/rgste_fstnm_marginleft</item>
        <item name="android:layout_marginRight">@dimen/rgste_fstnm_marginleft</item>
        <item name="android:padding">@dimen/rgste_fstnm_padding</item>
    </style>-->

    <style name="edtStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/rgste_fstnm_marginleft</item>
        <item name="android:layout_marginRight">@dimen/rgste_fstnm_marginleft</item>
        <item name="android:padding">@dimen/login_button_padding</item>
        <item name="fontFamily">@font/lato_medium</item>
        <item name="android:textSize">@dimen/edittext_hint_size</item>
    </style>

    <style name="myStatusTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/loginbg</item>
        <item name="android:textSize">@dimen/subscriptiontxt</item>
    </style>

    <style name="myStatusTextStyleRes">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/subscriptiontxt</item>
    </style>

    <style name="bigTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lato_medium</item>
        <item name="textAllCaps">true</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/rgstr_txtsize</item>
    </style>

    <style name="liturgiesListTitleTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lato_semibold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/myliturgytxtsize</item>
    </style>

    <style name="registerButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/lato_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/login_button_txtsize</item>
        <item name="backgroundTint">@color/loginbg</item>
        <item name="android:padding">@dimen/login_button_padding</item>
        <item name="android:layout_marginLeft">@dimen/rgste_fstnm_marginleft</item>
        <item name="android:layout_marginRight">@dimen/rgste_fstnm_marginleft</item>
    </style>

    <style name="liturgiesListImageStyle">
        <item name="android:layout_width">@dimen/fav_frag_img</item>
        <item name="android:layout_height">@dimen/fav_frag_img</item>
        <item name="android:layout_marginRight">@dimen/myliturgyimagmrg</item>
    </style>

    <style name="liturgiesListButtonStyle">
        <item name="fontFamily">@font/lato_medium</item>
        <item name="android:textColor">@color/loginbg</item>
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>

    <style name="dialogBigTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/lato_bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/dialog_main_text</item>
        <item name="android:text">Every Moment Holy</item>
    </style>

    <style name="dialogSmallTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/lato_medium</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/dialog_small_text</item>
    </style>


    <style name="Divider">
        <item name="android:background">?android:attr/listDivider</item>
        //you can give your color here. that will change all divider color in your app.
    </style>

    <style name="Divider.Vertical" parent="Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="dialogOkTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/lato_medium</item>
        <item name="android:textColor">@color/dialogOkTxt</item>
        <item name="android:textSize">@dimen/dialog_accept_text</item>
    </style>

    <style name="dialogCancelTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/dialogCancelTxt</item>
        <item name="android:textSize">@dimen/_16ssp</item>
    </style>

    <style name="subscriptionStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/_20sdp</item>
        <item name="android:layout_marginRight">@dimen/_20sdp</item>
        <item name="android:layout_marginTop">@dimen/_18sdp</item>
        <item name="android:layout_marginBottom">@dimen/_10sdp</item>
        <item name="android:padding">@dimen/_17sdp</item>
    </style>

    <style name="subscriptionTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/lato_bold</item>
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="freeTextStyle">
        <item name="fontFamily">@font/lato_medium</item>
        <item name="android:textColor">@color/loginbg</item>
        <item name="android:textSize">@dimen/buttomsheet_freetxt_size</item>
        <item name="android:text">@string/free</item>
    </style>

    <style name="Widget.Button" parent="android:Widget">
        <item name="android:background">@drawable/order_history</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CustomDialogTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="NewFontStyle" parent="android:Widget.TextView">

        <item name="fontFamily">@font/lato_regular</item>
    </style>

</resources>